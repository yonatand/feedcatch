# Keep the build context small and free of local state/secrets.
.git
.gitignore
.claude
.env
.env.*
!.env.example
data
**/node_modules
**/.venv
**/__pycache__
**/*.pyc
**/.mypy_cache
**/.ruff_cache
**/.pytest_cache
**/.data
**/*.db
**/*.db-wal
**/*.db-shm
backend/tests
frontend/dist
# Built in-image by the ui stage.
backend/app/static
.vscode
.idea
*.md
