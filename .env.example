# feedcatch configuration.
# Copy to .env (cp .env.example .env). Empty value = "not set".
# Values set here for QBIT_* / APP_PASSWORD / ALLOW_PRIVATE_FEED_HOSTS take precedence over what is
# saved in the web UI; the UI then shows those fields as coming from "env" and ignores edits to them.

# ---------------------------------------------------------------- container / host
# Host port the web UI is published on (container always listens on 8000).
APP_PORT=8000
# uid/gid the container runs as; must own ./data on the host (check with `id -u` / `id -g`).
PUID=1000
PGID=1000
# Log level: DEBUG, INFO, WARNING, ERROR. Logs are JSON on stdout (docker compose logs -f).
APP_LOG_LEVEL=INFO

# ---------------------------------------------------------------- security
# Key used to encrypt the stored qBittorrent password and sign session cookies.
# Empty = a random key is generated once and kept in ./data/secret.key (back it up with app.db).
# If you set it, keep it stable: changing it makes the stored qBittorrent password unreadable.
APP_SECRET_KEY=
# Web UI password. Empty = choose one on the first-run setup page (stored as a bcrypt hash).
# If set, it always wins over the stored password (also the way to reset a forgotten password).
APP_PASSWORD=
# true = NO login at all. Only for a trusted LAN or behind a reverse proxy that does its own auth.
APP_AUTH_DISABLED=false

# ---------------------------------------------------------------- qBittorrent
# URL as seen FROM THE CONTAINER. host.docker.internal = the Docker host (mapped in docker-compose.yml).
# Leave empty to configure it in the UI (qBittorrent page) instead.
QBIT_URL=http://host.docker.internal:8080
# Leave both empty if qBittorrent bypasses auth for this client's subnet, or to set them in the UI.
QBIT_USERNAME=
QBIT_PASSWORD=

# ---------------------------------------------------------------- feeds
# Feed URL used for the demo feed created on FIRST start only (later changes: Feeds page).
# Empty = https://feed.animetosho.net/rss2
FEED_URL=https://feed.animetosho.net/rss2
# Allow feed URLs that resolve to private/loopback/link-local addresses (SSRF guard).
# Empty = use the Settings page value (default false). true/false here overrides the UI.
ALLOW_PRIVATE_FEED_HOSTS=

# ---------------------------------------------------------------- reverse proxy (optional)
# Comma-separated proxy IPs whose X-Forwarded-For / X-Forwarded-Proto headers are trusted (read by uvicorn).
# Needed so the session cookie gets the Secure flag when TLS terminates at your proxy. "*" = trust any
# client IP; only use "*" if port 8000 is NOT reachable except through the proxy.
FORWARDED_ALLOW_IPS=
